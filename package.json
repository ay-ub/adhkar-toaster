{
  "name": "@ay-ub/adhkar-toaster",
  "version": "0.1.2",
  "description": "A customizable React adhkar reminder toaster powered by Sonner",
  "author": "ay-ub",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/adhkar-toaster.cjs",
  "module": "./dist/adhkar-toaster.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/adhkar-toaster.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.cts",
        "default": "./dist/adhkar-toaster.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ay-ub/adhkar-toaster.git"
  },
  "homepage": "https://github.com/ay-ub/adhkar-toaster#readme",
  "bugs": {
    "url": "https://github.com/ay-ub/adhkar-toaster/issues"
  },
  "keywords": [
    "adhkar",
    "dhikr",
    "react",
    "sonner",
    "toast",
    "islamic"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && pnpm build:types",
    "build:app": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.types.json && node scripts/copy-cjs-types.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sonner": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
